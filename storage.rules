rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isImageOrVideoOrDoc() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType.matches('application/.*');
    }
    function underSizeLimit() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB
    }

    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && underSizeLimit();
    }

    match /banners/{uid}/{file} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && underSizeLimit();
    }

    match /chatImages/{chatId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && underSizeLimit() && isImageOrVideoOrDoc();
    }

    match /chatVideos/{chatId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && underSizeLimit() && isImageOrVideoOrDoc();
    }

    match /voiceNotes/{chatId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /documents/{chatId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /stories/{uid}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid && underSizeLimit();
    }

    match /broadcast/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && underSizeLimit();
    }

    match /groups/{groupId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && underSizeLimit();
    }
  }
}
